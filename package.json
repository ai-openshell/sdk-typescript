{
  "name": "@ai-openshell/sdk",
  "version": "0.0.0",
  "description": "Official TypeScript SDK for the OpenShell gateway.",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/ai-openshell/sdk-typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-openshell/sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/ai-openshell/sdk-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "gen": "buf generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "test": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.2.3",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
